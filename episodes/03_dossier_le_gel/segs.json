[{"t0": 0.18, "t1": 3.34, "txt": "En 2027, personne ne va augmenter vos impôts."}, {"t0": 3.64, "t1": 6.36, "txt": "Et pourtant… vous allez perdre de l'argent."}, {"t0": 6.66, "t1": 8.85, "txt": "Le budget a été déposé le 1er octobre."}, {"t0": 9.14, "t1": 11.18, "txt": "54 milliards d'économies."}, {"t0": 11.48, "t1": 15.07, "txt": "Et le gouvernement le répète : pas de hausse généralisée d'impôts."}, {"t0": 15.58, "t1": 16.44, "txt": "Officiellement."}, {"t0": 16.74, "t1": 17.99, "txt": "Alors prenons une famille."}, {"t0": 18.29, "t1": 20.35, "txt": "Appelons-la… la famille Martin."}, {"t0": 20.65, "t1": 23.14, "txt": "Elle travaille. Elle touche la prime d'activité."}, {"t0": 23.44, "t1": 25.79, "txt": "Deux enfants. Les allocations familiales."}, {"t0": 26.09, "t1": 28.33, "txt": "Un petit appartement. Les APL."}, {"t0": 28.63, "t1": 30.02, "txt": "Et sa mère, à la retraite."}, {"t0": 30.32, "t1": 31.96, "txt": "1 400 euros par mois."}, {"t0": 32.26, "t1": 34.93, "txt": "Dans ce budget, personne ne leur retire rien."}, {"t0": 35.22, "t1": 36.25, "txt": "Rien n'est supprimé."}, {"t0": 36.49, "t1": 37.91, "txt": "Rien n'est voté contre eux."}, {"t0": 38.33, "t1": 40.41, "txt": "On fait juste… autre chose."}, {"t0": 40.71, "t1": 42.52, "txt": "La prime d'activité : gelée."}, {"t0": 42.82, "t1": 44.8, "txt": "Les allocations familiales : gelées."}, {"t0": 45.1, "t1": 46.53, "txt": "Les APL : gelées."}, {"t0": 46.83, "t1": 49.41, "txt": "La pension de sa mère : elle ne suivra pas les prix."}, {"t0": 49.89, "t1": 50.96, "txt": "Ça s'appelle un gel."}, {"t0": 51.26, "t1": 52.6, "txt": "Un gel, c'est simple."}, {"t0": 52.9, "t1": 54.87, "txt": "Les prix, eux, continuent de monter."}, {"t0": 55.17, "t1": 57.24, "txt": "Le loyer monte. Les courses montent."}, {"t0": 57.54, "t1": 59.1, "txt": "Et l'aide… ne bouge plus."}, {"t0": 59.4, "t1": 60.12, "txt": "Le plus troublant ?"}, {"t0": 60.42, "t1": 64.64, "txt": "Pour calculer votre impôt, l'État compte 2,1 % d'inflation."}, {"t0": 64.94, "t1": 65.65, "txt": "Pour vos aides…"}, {"t0": 66.02, "t1": 67.24, "txt": "il compte zéro."}, {"t0": 67.54, "t1": 69.96, "txt": "Personne ne verra une ligne en moins sur son compte."}, {"t0": 70.26, "t1": 72.88, "txt": "Pas de lettre. Pas d'annonce. Pas de coupable."}, {"t0": 73.3, "t1": 75.36, "txt": "Juste un frigo un peu moins plein."}, {"t0": 75.72, "t1": 77.39, "txt": "Chaque mois. Un peu plus."}, {"t0": 77.69, "t1": 79.18, "txt": "Les plus pauvres sont protégés :"}, {"t0": 79.48, "t1": 82.95, "txt": "le RSA et l'AAH, eux, suivent l'inflation."}, {"t0": 83.25, "t1": 87.29, "txt": "Mais ceux qui travaillent, qui élèvent des enfants, qui ont cotisé toute leur vie…"}, {"t0": 87.69, "t1": 89.46, "txt": "eux, on les laisse refroidir."}, {"t0": 89.76, "t1": 91.27, "txt": "Un impôt, ça se voit."}, {"t0": 91.57, "t1": 92.4, "txt": "Ça se conteste."}, {"t0": 92.7, "t1": 94.07, "txt": "Ça fait descendre dans la rue."}, {"t0": 94.37, "t1": 96.29, "txt": "Un gel… ça ne fait pas de bruit."}, {"t0": 96.67, "t1": 97.77, "txt": "Ça fait juste froid."}, {"t0": 98.19, "t1": 99.92, "txt": "Ce budget n'est encore qu'un projet."}, {"t0": 100.22, "t1": 102.24, "txt": "Il se joue à l'Assemblée. Maintenant."}, {"t0": 102.66, "t1": 105.09, "txt": "Alors… vous, vous perdez combien ?"}]