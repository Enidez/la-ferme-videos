[{"t0": 0.167, "t1": 0.963, "txt": "Il avait 15 ans."}, {"t0": 1.148, "t1": 3.009, "txt": "Il était dans ce lycée depuis quelques semaines."}, {"t0": 3.194, "t1": 4.667, "txt": "Lundi 5 octobre…"}, {"t0": 5.083, "t1": 6.083, "txt": "il a perdu une main."}, {"t0": 6.269, "t1": 6.704, "txt": "Lens."}, {"t0": 6.889, "t1": 8.852, "txt": "Lycée professionnel Auguste-Béhal."}, {"t0": 9.037, "t1": 12.463, "txt": "Ce matin-là, 200 à 250 lycéens sont rassemblés."}, {"t0": 12.648, "t1": 16.241, "txt": "Selon le préfet : des pierres, des feux d'artifice, des mortiers."}, {"t0": 16.426, "t1": 18.176, "txt": "Une compagnie de CRS est déployée."}, {"t0": 18.361, "t1": 20.0, "txt": "Les sommations restent sans effet."}, {"t0": 20.185, "t1": 21.583, "txt": "Deux grenades lacrymogènes."}, {"t0": 21.769, "t1": 22.806, "txt": "Puis une troisième."}, {"t0": 22.991, "t1": 24.556, "txt": "Une grenade assourdissante."}, {"t0": 24.972, "t1": 25.685, "txt": "Elle explose."}, {"t0": 27.278, "t1": 29.787, "txt": "Et un adolescent de 15 ans se retrouve à l'hôpital."}, {"t0": 30.204, "t1": 30.787, "txt": "Sans sa main."}, {"t0": 30.972, "t1": 32.546, "txt": "Depuis, il y a deux versions."}, {"t0": 32.731, "t1": 34.454, "txt": "La première, c'est celle du parquet."}, {"t0": 34.639, "t1": 36.019, "txt": "La grenade a été tirée de loin."}, {"t0": 36.204, "t1": 37.13, "txt": "Elle est tombée au sol."}, {"t0": 37.315, "t1": 38.574, "txt": "Le lycéen l'aurait ramassée."}, {"t0": 38.759, "t1": 39.981, "txt": "Elle a explosé dans sa main."}, {"t0": 40.38, "t1": 42.713, "txt": "Et il n'existe aucune vidéo de l'explosion."}, {"t0": 42.898, "t1": 44.954, "txt": "La deuxième, c'est celle de sa famille."}, {"t0": 45.139, "t1": 46.306, "txt": "Son avocate l'affirme :"}, {"t0": 46.491, "t1": 48.5, "txt": "il n'a jamais ramassé cette grenade."}, {"t0": 48.685, "t1": 50.796, "txt": "Plusieurs témoins racontent qu'elle est tombée sur lui."}, {"t0": 50.981, "t1": 52.194, "txt": "Sa mère a porté plainte."}, {"t0": 52.38, "t1": 53.426, "txt": "Une enquête est ouverte."}, {"t0": 53.611, "t1": 56.0, "txt": "Pour violences ayant entraîné une mutilation."}, {"t0": 56.417, "t1": 57.444, "txt": "Mais regardez bien les dates."}, {"t0": 57.63, "t1": 60.991, "txt": "Le 7 octobre, le ministre de l'Intérieur suspend cette grenade."}, {"t0": 61.176, "t1": 61.685, "txt": "Pas partout."}, {"t0": 61.87, "t1": 63.139, "txt": "Seulement pour les lycéens."}, {"t0": 63.324, "t1": 66.352, "txt": "Le 9 octobre, le procureur rend ses premières conclusions."}, {"t0": 66.685, "t1": 68.435, "txt": "Le tir était… « conforme »."}, {"t0": 68.852, "t1": 69.519, "txt": "Conforme."}, {"t0": 69.704, "t1": 71.056, "txt": "Conforme à la formation."}, {"t0": 71.241, "t1": 72.352, "txt": "Conforme aux ordres."}, {"t0": 72.537, "t1": 74.074, "txt": "Une chaîne d'instructions strictes."}, {"t0": 74.491, "t1": 75.713, "txt": "Personne n'a désobéi."}, {"t0": 75.898, "t1": 77.463, "txt": "Alors posez-vous la vraie question."}, {"t0": 77.648, "t1": 79.269, "txt": "Si tout a été fait dans les règles…"}, {"t0": 79.611, "t1": 81.111, "txt": "c'est que les règles permettent ça."}, {"t0": 81.296, "t1": 84.389, "txt": "Une arme qu'on a le droit d'utiliser… devant un lycée…"}, {"t0": 84.574, "t1": 86.056, "txt": "où il y a des enfants de 15 ans."}, {"t0": 86.241, "t1": 90.722, "txt": "Plus de 100 000 personnes ont signé une pétition pour interdire ces armes face aux lycéens."}, {"t0": 90.907, "t1": 94.759, "txt": "18 enquêtes ont été ouvertes par l'IGPN depuis le début du mouvement."}, {"t0": 94.944, "t1": 96.278, "txt": "La grenade est suspendue."}, {"t0": 96.463, "t1": 97.12, "txt": "Pas interdite."}, {"t0": 97.537, "t1": 98.037, "txt": "Suspendue."}, {"t0": 98.222, "t1": 101.019, "txt": "On ne sait pas encore exactement ce qui s'est passé ce matin-là."}, {"t0": 101.204, "t1": 102.269, "txt": "L'enquête le dira."}, {"t0": 102.611, "t1": 103.963, "txt": "Mais une chose est déjà sûre."}, {"t0": 104.148, "t1": 105.713, "txt": "Un adolescent a perdu sa main…"}, {"t0": 106.083, "t1": 108.806, "txt": "et, pour l'instant, personne n'a fait d'erreur."}, {"t0": 109.13, "t1": 110.824, "txt": "Conforme… et suspendue."}, {"t0": 111.009, "t1": 112.685, "txt": "Les deux sont vrais en même temps."}, {"t0": 113.102, "t1": 115.333, "txt": "Et c'est peut-être ça… le plus inquiétant."}]